{
  "name": "claude-terminal",
  "version": "0.1.14",
  "description": "Terminal desktop cho Claude Code tren Windows, co luu va tra cuu lich su phien lam viec",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "electron"
  ],
  "license": "MIT",
  "author": "mccquakhu-alt <mccquakhu@gmail.com>",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.klterminal.app",
    "productName": "KLTERMINAL",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "!**/*.map"
    ],
    "asarUnpack": [
      "src/main/history/history-worker.js",
      "src/main/history/transcript-parser.js",
      "node_modules/@lydell/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "hoangmanhtuan165",
      "repo": "claude-terminal"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KLTERMINAL"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "mccquakhu-alt <mccquakhu@gmail.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
